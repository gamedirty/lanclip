{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanClip",
  "version": "0.1.0",
  "identifier": "app.lanclip.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "LanClip · 局域网剪切板同步",
        "width": 980,
        "height": 660,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "visible": true
      },
      {
        "label": "popup",
        "url": "popup.html",
        "width": 400,
        "height": 230,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
